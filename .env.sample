# text-embedding-3-large

# EMBEDDING_MODEL=openai/text-embedding-3-large

# EMBEDDING_DIM=3072

# EMBEDDING_PREFIX_QUERY=""

# EMBEDDING_PREFIX_EMBEDDING=""



